{
	"name": "witoldzawada-dev",
	"version": "1.0.0",
	"author": "Witold Zawada (PoProstuWitold) <witoldzawada.dev@gmail.com>",
	"private": true,
	"description": "My personal portfolio website showcasing my projects, experience, and technical articles.",
	"homepage": "https://witoldzawada.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PoProstuWitold/portfolio.git"
	},
	"bugs": {
		"url": "https://github.com/PoProstuWitold/portfolio/issues"
	},
	"engines": {
		"node": ">=22.x",
		"pnpm": ">=9.x"
	},
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"analyze": "ANALYZE=true next build",
		"start": "next start",
		"clean": "rimraf .next coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"check": "biome check . && pnpm run typecheck",
		"check:fix": "biome check --write . && pnpm run typecheck",
		"test": "tsx --test __tests__/*.test.ts",
		"test:watch": "tsx --test --watch __tests__/*.test.ts",
		"ci": "pnpm run check && pnpm run test && pnpm run build"
	},
	"keywords": [
		"typescript",
		"nodejs",
		"nextjs",
		"react",
		"portfolio"
	],
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/luxon": "^3.7.5",
		"@types/node": "^26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@types/react-syntax-highlighter": "^15.5.13",
		"daisyui": "5.7.22",
		"rimraf": "^6.1.3",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@headlessui/react": "^2.2.10",
		"@next/bundle-analyzer": "16.3.3",
		"@octokit/graphql": "^9.0.4",
		"@tailwindcss/line-clamp": "^0.4.4",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"autoprefixer": "^10.5.4",
		"classnames": "^2.5.1",
		"dayjs": "^1.11.23",
		"feed": "^6.0.0",
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"luxon": "^3.7.2",
		"motion": "^13.1.1",
		"next": "16.3.3",
