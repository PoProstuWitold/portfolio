		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"react-syntax-highlighter": "^16.1.1",
		"react-web-share": "^2.0.2",
		"reading-time": "^1.5.0",
